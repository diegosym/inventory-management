# Ignore bundler config.
/.bundle

# Ignore environment files (C16: never commit secrets); keep the template.
/.env*
!/.env.example

# Ignore the master key for decrypting credentials and more.
/config/master.key
/config/credentials.yml.enc

# Ignore logfiles and tempfiles.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore storage (uploaded files in development).
/storage/*
!/storage/.keep
