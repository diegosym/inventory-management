# Copy to .env and adjust. Development-only values (C16: .env is never committed).

# Database credentials shared by the `db` and `backend` compose services.
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=inventory_development

# Production deploys only: backend/config/database.yml reads DATABASE_URL in the
# production environment. The compose backend service uses POSTGRES_* instead.
DATABASE_URL=postgres://user:password@host:5432/inventory_production

# CORS origin allowed by the backend (RF-8); the frontend dev server origin.
FRONTEND_ORIGIN=http://localhost:5173

# Base URL the browser uses to reach the backend API from the frontend
# (spec 002, D-P14): the host-mapped backend port, not the compose-internal
# hostname `backend` (unresolvable from the host browser).
VITE_API_BASE_URL=http://localhost:3000
